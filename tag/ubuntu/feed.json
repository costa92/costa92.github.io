span class=\"token punctuation\">)</span> <span class=\"token builtin\">string</span> <span class=\"token punctuation\">{</span>\n\ta<span class=\"token punctuation\">,</span> err <span class=\"token operator\">:=</span> time<span class=\"token punctuation\">.</span><span class=\"token function\">LoadLocation</span><span class=\"token punctuation\">(</span>alias<span class=\"token punctuation\">)</span>\n\t<span class=\"token keyword\">if</span> err <span class=\"token operator\">!=</span> <span class=\"token boolean\">nil</span> <span class=\"token punctuation\">{</span>\n\t\t<span class=\"token keyword\">return</span> fmt<span class=\"token punctuation\">.</span><span class=\"token function\">Sprintf</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"%s: %v\"</span><span class=\"token punctuation\">,</span> alias<span class=\"token punctuation\">,</span> err<span class=\"token punctuation\">)</span>\n\t<span class=\"token punctuation\">}</span>\n\tb<span class=\"token punctuation\">,</span> err <span class=\"token operator\">:=</span> time<span class=\"token punctuation\">.</span><span class=\"token function\">LoadLocation</span><span class=\"token punctuation\">(</span>target<span class=\"token punctuation\">)</span>\n\t<span class=\"token keyword\">if</span> err <span class=\"token operator\">!=</span> <span class=\"token boolean\">nil</span> <span class=\"token punctuation\">{</span>\n\t\t<span class=\"token keyword\">return</span> fmt<span class=\"token punctuation\">.</span><span class=\"token function\">Sprintf</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"%s -&gt; %s: 目标加载失败: %v\"</span><span class=\"token punctuation\">,</span> alias<span class=\"token punctuation\">,</span> target<span class=\"token punctuation\">,</span> err<span class=\"token punctuation\">)</span>\n\t<span class=\"token punctuation\">}</span>\n\t<span class=\"token keyword\">for</span> t <span class=\"token operator\">:=</span> time<span class=\"token punctuation\">.</span><span class=\"token function\">Date</span><span class=\"token punctuation\">(</span><span class=\"token number\">1970</span><span class=\"token punctuation\">,</span> <span class=\"token number\">1</span><span class=\"token punctuation\">,</span> <span class=\"token number\">1</span><span class=\"token punctuation\">,</span> <span class=\"token number\">12</span><span class=\"token punctuation\">,</span> <span class=\"token number\">0</span><span class=\"token punctuation\">,</span> <span class=\"token number\">0</span><span class=\"token punctuation\">,</span> <span class=\"token number\">0</span><span class=\"token punctuation\">,</span> time<span class=\"token punctuation\">.</span>UTC<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span> t<span class=\"token punctuation\">.</span><span class=\"token function\">Year</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">&lt;=</span> <span class=\"token number\">2037</span><span class=\"token punctuation\">;</span> t <span class=\"token operator\">=</span> t<span class=\"token punctuation\">.</span><span class=\"token function\">AddDate</span><span class=\"token punctuation\">(</span><span class=\"token number\">0</span><span class=\"token punctuation\">,</span> <span class=\"token number\">0</span><span class=\"token punctuation\">,</span> <span class=\"token number\">14</span><span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n\t\tan<span class=\"token punctuation\">,</span> ao <span class=\"token operator\">:=</span> t<span class=\"token punctuation\">.</span><span class=\"token function\">In</span><span class=\"token punctuation\">(</span>a<span class=\"token punctuation\">)</span><span class=\"token punctuation\">.</span><span class=\"token function\">Zone</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span>\n\t\tbn<span class=\"token punctuation\">,</span> bo <span class=\"token operator\">:=</span> t<span class=\"token punctuation\">.</span><span class=\"token function\">In</span><span class=\"token punctuation\">(</span>b<span class=\"token punctuation\">)</span><span class=\"token punctuation\">.</span><span class=\"token function\">Zone</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span>\n\t\t<span class=\"token keyword\">if</span> an <span class=\"token operator\">!=</span> bn <span class=\"token operator\">||</span> ao <span class=\"token operator\">!=</span> bo <span class=\"token punctuation\">{</span>\n\t\t\t<span class=\"token keyword\">return</span> fmt<span class=\"token punctuation\">.</span><span class=\"token function\">Sprintf</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"%s vs %s @ %s: %s%+d vs %s%+d\"</span><span class=\"token punctuation\">,</span> alias<span class=\"token punctuation\">,</span> target<span class=\"token punctuation\">,</span> t<span class=\"token punctuation\">.</span><span class=\"token function\">Format</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"2006-01-02\"</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">,</span> an<span class=\"token punctuation\">,</span> ao<span class=\"token punctuation\">,</span> bn<span class=\"token punctuation\">,</span> bo<span class=\"token punctuation\">)</span>\n\t\t<span class=\"token punctuation\">}</span>\n\t<span class=\"token punctuation\">}</span>\n\t<span class=\"token keyword\">return</span> <span class=\"token string\">\"\"</span>\n<span class=\"token punctuation\">}</span>\n\n<span class=\"token keyword\">func</span> <span class=\"token function\">fail</span><span class=\"token punctuation\">(</span>format <span class=\"token builtin\">string</span><span class=\"token punctuation\">,</span> args <span class=\"token operator\">...</span>any<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n\tfmt<span class=\"token punctuation\">.</span><span class=\"token function\">Fprintf</span><span class=\"token punctuation\">(</span>os<span class=\"token punctuation\">.</span>Stderr<span class=\"token punctuation\">,</span> <span class=\"token string\">\"tz-verify: \"</span><span class=\"token operator\">+</span>format<span class=\"token operator\">+</span><span class=\"token string\">\"\\n\"</span><span class=\"token punctuation\">,</span> args<span class=\"token operator\">...</span><span class=\"token punctuation\">)</span>\n\tos<span class=\"token punctuation\">.</span><span class=\"token function\">Exit</span><span class=\"token punctuation\">(</span><span class=\"token number\">1</span><span class=\"token punctuation\">)</span>\n<span class=\"token punctuation\">}</span></code></pre>\n\n<p>两段式 Dockerfile，第二段换成你自己的基础镜像。构建目录里放 <code>main.go</code> 和 <code>go.mod</code>，<code>go.mod</code> 用 <code>go mod init tzverify</code> 生成即可，程序只用标准库。<code>TZ_PKGS</code> 默认装 <code>tzdata tzdata-legacy</code>，传 <code>--build-arg TZ_PKGS=tzdata</code> 可以复现上表里的失败；<code>ubuntu:22.04</code> 没有 <code>tzdata-legacy</code> 这个包，也要这样传。</p>\n<pre class=\"language-docker\" data-language=\"docker\"><code class=\"language-docker\"><span class=\"token instruction\"><span class=\"token keyword\">ARG</span> BASE_IMAGE=ubuntu:26.04</span>\n<span class=\"token instruction\"><span class=\"token keyword\">ARG</span> GO_IMAGE=golang:1.27</span>\n\n<span class=\"token instruction\"><span class=\"token keyword\">FROM</span> <span class=\"token variable\">${GO_IMAGE}</span> <span class=\"token keyword\">AS</span> build</span>\n<span class=\"token instruction\"><span class=\"token keyword\">WORKDIR</span> /src</span>\n<span class=\"token instruction\"><span class=\"token keyword\">COPY</span> go.mod main.go ./</span>\n<span class=\"token instruction\"><span class=\"token keyword\">RUN</span> CGO_ENABLED=0 go build -trimpath -o /tz-verify .</span>\n\n<span class=\"token instruction\"><span class=\"token keyword\">FROM</span> <span class=\"token variable\">${BASE_IMAGE}</span></span>\n<span class=\"token instruction\"><span class=\"token keyword\">ARG</span> TZ_PKGS=<span class=\"token string\">\"tzdata tzdata-legacy\"</span></span>\n<span class=\"token instruction\"><span class=\"token keyword\">ENV</span> DEBIAN_FRONTEND=noninteractive</span>\n<span class=\"token instruction\"><span class=\"token keyword\">RUN</span> apt-get update &amp;&amp; apt-get install -y --no-install-recommends <span class=\"token variable\">${TZ_PKGS}</span> <span class=\"token operator\">\\</span>\n &amp;&amp; ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime <span class=\"token operator\">\\</span>\n &amp;&amp; rm -rf /var/lib/apt/lists/*</span>\n<span class=\"token instruction\"><span class=\"token keyword\">COPY</span> <span class=\"token options\"><span class=\"token property\">--from</span><span class=\"token punctuation\">=</span><span class=\"token string\">build</span></span> /tz-verify /usr/local/bin/tz-verify</span>\n<span class=\"token comment\"># 构建期校验：系统时区数据里每个别名都能加载且与标准名一致，否则构建失败</span>\n<span class=\"token instruction\"><span class=\"token keyword\">RUN</span> /usr/local/bin/tz-verify</span></code></pre>\n",
